---
// Phase A placeholder — will be replaced with full Library subdomain content in Phase D.
import Layout from '../../../layouts/Layout.astro';
export const prerender = false;
---

<Layout
  title="Library — Margdarshak Shikshan Sansthan"
  description="Margdarshak Library & Reading Room, Darbhanga."
  noindex={true}
>
  <div class="min-h-[70vh] flex items-center justify-center px-4 py-16">
    <div class="max-w-xl w-full text-center space-y-6">
      <div class="glass-card-premium p-10 rounded-3xl border border-slate-200/60 shadow-premium space-y-5">
        <div class="w-16 h-16 bg-primary/10 rounded-2xl flex items-center justify-center mx-auto">
          <span class="material-symbols-outlined text-primary text-3xl">local_library</span>
        </div>
        <h1 class="text-2xl md:text-3xl font-headline font-black text-primary">
          Library Portal — <span class="text-gradient-purple-orange">Coming Soon</span>
        </h1>
        <p class="text-slate-500 text-sm md:text-base">
          We're preparing our Library & Reading Room portal. Check back soon or contact us directly.
        </p>
        <a
          href="https://margdarshakss.com/contact"
          class="inline-flex items-center gap-2 btn-brand-gradient text-white font-bold px-6 py-3 rounded-xl hover-lift"
        >
          <span class="material-symbols-outlined text-sm">phone</span>
          Contact Us
        </a>
      </div>
    </div>
  </div>
</Layout>
