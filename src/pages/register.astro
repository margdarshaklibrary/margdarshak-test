---
import Layout from '../layouts/Layout.astro';
import { getCourses, getInternships } from '../data/db.js';

const courses = await getCourses();
const internships = await getInternships();
---

<Layout 
  title="Admissions & Program Inquiries — Margdarshak Shikshan Sansthan, Darbhanga" 
  description="Margdarshak Shikshan Sansthan is currently redesigning its platform. Connect with our admissions counselors on WhatsApp for instant course & internship seat bookings."
  ogImage="/assets/register_hero.jpg"
>
  
  <!-- Hero Section with Redesign Notice Banner -->
  <section class="hero-gradient text-white py-16 md:py-24 relative overflow-hidden">
    <!-- Background glows -->
    <div class="glow-blob bg-secondary/15 w-[350px] h-[350px] top-10 left-10 animate-float-slow" aria-hidden="true"></div>
    <div class="glow-blob bg-accent/15 w-[400px] h-[400px] -bottom-20 right-10 animate-float-medium" aria-hidden="true"></div>

    <div class="max-w-[1440px] mx-auto px-4 md:px-6 relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      <!-- Hero Text Column -->
      <div class="lg:col-span-7 space-y-6 text-left">
        <div class="inline-flex items-center gap-2 bg-amber-400/10 border border-amber-400/30 px-4 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider text-amber-300">
          <span class="material-symbols-outlined text-sm font-bold">construction</span>
          Platform Notice
        </div>

        <h1 class="text-4xl md:text-6xl font-headline font-black leading-tight tracking-tight">
          We Are Redesigning<br />
          <span class="text-gradient-white-orange">Our Platform.</span>
        </h1>

        <p class="text-slate-300 max-w-2xl text-base md:text-lg leading-relaxed font-body">
          Our online admission system is currently undergoing a complete redesign to serve you better. During this period, online registration forms are paused.
        </p>

        <!-- Redesign Notice Box with WhatsApp CTA -->
        <div class="bg-white/10 border border-white/20 p-6 md:p-8 rounded-3xl backdrop-blur-xl shadow-glass space-y-4">
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-2xl bg-[#25D366]/20 border border-[#25D366]/40 flex items-center justify-center text-[#25D366] shrink-0">
              <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946C.06 5.348 5.397.01 12.008.01c3.202.001 6.212 1.246 8.477 3.514 2.266 2.268 3.507 5.28 3.505 8.484-.004 6.657-5.34 11.997-11.953 11.997-2.005-.001-3.973-.502-5.724-1.455L0 24zm6.59-4.846c1.6.95 3.588 1.485 5.407 1.486 5.49.003 9.953-4.461 9.956-9.956.002-2.662-1.032-5.164-2.909-7.042C17.225 1.762 14.72 .727 12.008.727c-5.499 0-9.963 4.463-9.967 9.96c-.001 1.958.51 3.868 1.482 5.51L2.551 22.08l6.096-1.602c1.78.97 3.84 1.488 5.92 1.488zM18.02 14.86c-.33-.165-1.95-.963-2.25-1.073-.3-.11-.52-.165-.74.165-.22.33-.85 1.073-1.04 1.293-.19.22-.38.248-.71.083-.33-.165-1.4-.516-2.668-1.648-.986-.88-1.653-1.968-1.846-2.3-.19-.33-.02-.508.145-.672.15-.148.33-.385.495-.578.165-.192.22-.33.33-.55.11-.22.05-.413-.025-.578-.075-.165-.74-1.788-1.01-2.45-.27-.648-.54-.56-.74-.57h-.63c-.22 0-.58.083-.88.413-.3.33-1.15 1.128-1.15 2.75s1.18 3.19 1.35 3.41c.17.22 2.33 3.56 5.65 4.99 2.76 1.19 3.75 1.29 5.09 1.09.78-.115 2.33-.95 2.66-1.87.33-.92.33-1.705.23-1.87-.1-.165-.36-.275-.72-.44z"/>
              </svg>
            </div>
            <div class="space-y-1">
              <h3 class="font-headline font-bold text-white text-lg">Contact Us Directly on WhatsApp</h3>
              <p class="text-slate-200 text-sm leading-relaxed font-body">
                Admissions, counseling, batch allotments, and fee refund queries are actively handled via WhatsApp. Click below to message our admissions desk directly.
              </p>
            </div>
          </div>

          <div class="pt-2 flex flex-col sm:flex-row gap-3">
            <a 
              href="https://wa.me/919229025257?text=Hi%20Margdarshak%20Team,%20I%20am%20interested%20in%20enrolling%20in%20your%20programs." 
              target="_blank" 
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-3 px-8 py-4 bg-[#25D366] hover:bg-[#20ba5a] text-white font-bold rounded-2xl shadow-lg hover:scale-[1.03] active:scale-[0.98] transition-all duration-300 font-headline text-sm md:text-base"
            >
              <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946C.06 5.348 5.397.01 12.008.01c3.202.001 6.212 1.246 8.477 3.514 2.266 2.268 3.507 5.28 3.505 8.484-.004 6.657-5.34 11.997-11.953 11.997-2.005-.001-3.973-.502-5.724-1.455L0 24zm6.59-4.846c1.6.95 3.588 1.485 5.407 1.486 5.49.003 9.953-4.461 9.956-9.956.002-2.662-1.032-5.164-2.909-7.042C17.225 1.762 14.72 .727 12.008.727c-5.499 0-9.963 4.463-9.967 9.96c-.001 1.958.51 3.868 1.482 5.51L2.551 22.08l6.096-1.602c1.78.97 3.84 1.488 5.92 1.488zM18.02 14.86c-.33-.165-1.95-.963-2.25-1.073-.3-.11-.52-.165-.74.165-.22.33-.85 1.073-1.04 1.293-.19.22-.38.248-.71.083-.33-.165-1.4-.516-2.668-1.648-.986-.88-1.653-1.968-1.846-2.3-.19-.33-.02-.508.145-.672.15-.148.33-.385.495-.578.165-.192.22-.33.33-.55.11-.22.05-.413-.025-.578-.075-.165-.74-1.788-1.01-2.45-.27-.648-.54-.56-.74-.57h-.63c-.22 0-.58.083-.88.413-.3.33-1.15 1.128-1.15 2.75s1.18 3.19 1.35 3.41c.17.22 2.33 3.56 5.65 4.99 2.76 1.19 3.75 1.29 5.09 1.09.78-.115 2.33-.95 2.66-1.87.33-.92.33-1.705.23-1.87-.1-.165-.36-.275-.72-.44z"/>
              </svg>
              <span>Chat on WhatsApp (+91 92290 25257)</span>
            </a>
            <a 
              href="tel:+919229025257" 
              class="inline-flex items-center justify-center gap-2 px-6 py-4 bg-white/10 hover:bg-white/20 border border-white/20 text-white font-bold rounded-2xl transition-all duration-300 font-headline text-sm"
            >
              <span class="material-symbols-outlined text-lg">call</span>
              <span>Call Us</span>
            </a>
          </div>
        </div>

        <!-- Premium Feature Highlights -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-2">
          <div class="bg-white/5 border border-white/10 p-4 rounded-2xl flex items-center gap-3 shadow-glass">
            <div class="w-8 h-8 rounded-full bg-secondary/20 flex items-center justify-center text-secondary shrink-0">
              <span class="material-symbols-outlined text-base font-bold">check</span>
            </div>
            <span class="text-sm font-bold text-white leading-tight font-headline">Hybrid Learning</span>
          </div>
          <div class="bg-white/5 border border-white/10 p-4 rounded-2xl flex items-center gap-3 shadow-glass">
            <div class="w-8 h-8 rounded-full bg-accent/20 flex items-center justify-center text-accent shrink-0">
              <span class="material-symbols-outlined text-base font-bold">check</span>
            </div>
            <span class="text-sm font-bold text-white leading-tight font-headline">100% Fee Refund</span>
          </div>
          <div class="bg-white/5 border border-white/10 p-4 rounded-2xl flex items-center gap-3 shadow-glass">
            <div class="w-8 h-8 rounded-full bg-secondary/20 flex items-center justify-center text-secondary shrink-0">
              <span class="material-symbols-outlined text-base font-bold">check</span>
            </div>
            <span class="text-sm font-bold text-white leading-tight font-headline">Govt. Registered</span>
          </div>
        </div>
      </div>

      <!-- Hero Visual Column -->
      <div class="lg:col-span-5 flex justify-center items-center">
        <div class="relative w-full max-w-md lg:max-w-none">
          <div class="absolute inset-0 bg-gradient-to-tr from-secondary/30 to-accent/30 rounded-3xl blur-2xl opacity-30 animate-pulse-glow"></div>
          <picture>
            <img 
              src="/assets/register_hero.jpg" 
              alt="Margdarshak Shikshan Sansthan admissions desk" 
              class="w-full h-auto object-cover rounded-3xl shadow-2xl border border-white/10 relative z-10 animate-float-slow hover:scale-[1.02] transition-transform duration-500"
              loading="eager"
              fetchpriority="high"
              decoding="async"
              width="600"
              height="400"
            />
          </picture>
        </div>
      </div>

    </div>
  </section>

  <!-- Programs Overview Section with WhatsApp Action -->
  <section class="py-16 md:py-24 bg-slate-50 relative">
    <div class="max-w-[1440px] mx-auto px-4 md:px-6 space-y-12">
      
      <div class="text-center space-y-3 max-w-2xl mx-auto">
        <div class="inline-flex items-center gap-1.5 bg-secondary/10 border border-secondary/20 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider text-secondary">
          <span class="material-symbols-outlined text-sm font-bold">school</span>
          Explore Programs
        </div>
        <h2 class="text-3xl md:text-4xl font-headline font-black text-primary leading-tight">
          Inquire About Our Programs
        </h2>
        <p class="text-slate-500 font-body text-sm">
          Browse our career-focused courses and internships below, then contact our counseling desk on WhatsApp to confirm your batch.
        </p>
      </div>

      <!-- Grid of popular programs -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {courses.slice(0, 3).map((course) => (
          <div class="bg-white border border-slate-200/80 rounded-2xl p-6 shadow-sm hover:shadow-premium transition-all space-y-4 flex flex-col justify-between">
            <div class="space-y-3">
              <div class="inline-block px-3 py-1 bg-secondary/10 text-secondary text-xs font-bold rounded-lg font-headline">
                Course • {course.duration}
              </div>
              <h3 class="text-lg font-headline font-bold text-primary">{course.name}</h3>
              <p class="text-slate-500 text-xs font-body leading-relaxed line-clamp-2">{course.shortDescription}</p>
            </div>
            <div class="pt-2 border-t border-slate-100 flex items-center justify-between gap-3">
              <a href={`/courses/${course.id}`} class="text-xs font-bold text-primary hover:text-secondary font-headline">
                View Details →
              </a>
              <a 
                href={`https://wa.me/919229025257?text=Hi,%20I%20am%20interested%20in%20the%20${encodeURIComponent(course.name)}%20course.`}
                target="_blank"
                rel="noopener noreferrer"
                class="px-4 py-2 bg-[#25D366] hover:bg-[#20ba5a] text-white text-xs font-bold rounded-xl flex items-center gap-1.5 shadow-sm transition-all hover:scale-105"
              >
                <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                  <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946C.06 5.348 5.397.01 12.008.01c3.202.001 6.212 1.246 8.477 3.514 2.266 2.268 3.507 5.28 3.505 8.484-.004 6.657-5.34 11.997-11.953 11.997-2.005-.001-3.973-.502-5.724-1.455L0 24zm6.59-4.846c1.6.95 3.588 1.485 5.407 1.486 5.49.003 9.953-4.461 9.956-9.956.002-2.662-1.032-5.164-2.909-7.042C17.225 1.762 14.72 .727 12.008.727c-5.499 0-9.963 4.463-9.967 9.96c-.001 1.958.51 3.868 1.482 5.51L2.551 22.08l6.096-1.602c1.78.97 3.84 1.488 5.92 1.488zM18.02 14.86c-.33-.165-1.95-.963-2.25-1.073-.3-.11-.52-.165-.74.165-.22.33-.85 1.073-1.04 1.293-.19.22-.38.248-.71.083-.33-.165-1.4-.516-2.668-1.648-.986-.88-1.653-1.968-1.846-2.3-.19-.33-.02-.508.145-.672.15-.148.33-.385.495-.578.165-.192.22-.33.33-.55.11-.22.05-.413-.025-.578-.075-.165-.74-1.788-1.01-2.45-.27-.648-.54-.56-.74-.57h-.63c-.22 0-.58.083-.88.413-.3.33-1.15 1.128-1.15 2.75s1.18 3.19 1.35 3.41c.17.22 2.33 3.56 5.65 4.99 2.76 1.19 3.75 1.29 5.09 1.09.78-.115 2.33-.95 2.66-1.87.33-.92.33-1.705.23-1.87-.1-.165-.36-.275-.72-.44z"/>
                </svg>
                Inquire
              </a>
            </div>
          </div>
        ))}

        {internships.slice(0, 3).map((internship) => (
          <div class="bg-white border border-slate-200/80 rounded-2xl p-6 shadow-sm hover:shadow-premium transition-all space-y-4 flex flex-col justify-between">
            <div class="space-y-3">
              <div class="inline-block px-3 py-1 bg-brandOrange/10 text-brandOrange text-xs font-bold rounded-lg font-headline">
                Internship • {internship.duration}
              </div>
              <h3 class="text-lg font-headline font-bold text-primary">{internship.name}</h3>
              <p class="text-slate-500 text-xs font-body leading-relaxed line-clamp-2">{internship.shortDescription}</p>
            </div>
            <div class="pt-2 border-t border-slate-100 flex items-center justify-between gap-3">
              <a href={`/internships/${internship.id}`} class="text-xs font-bold text-primary hover:text-secondary font-headline">
                View Details →
              </a>
              <a 
                href={`https://wa.me/919229025257?text=Hi,%20I%20am%20interested%20in%20the%20${encodeURIComponent(internship.name)}%20internship.`}
                target="_blank"
                rel="noopener noreferrer"
                class="px-4 py-2 bg-[#25D366] hover:bg-[#20ba5a] text-white text-xs font-bold rounded-xl flex items-center gap-1.5 shadow-sm transition-all hover:scale-105"
              >
                <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                  <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946C.06 5.348 5.397.01 12.008.01c3.202.001 6.212 1.246 8.477 3.514 2.266 2.268 3.507 5.28 3.505 8.484-.004 6.657-5.34 11.997-11.953 11.997-2.005-.001-3.973-.502-5.724-1.455L0 24zm6.59-4.846c1.6.95 3.588 1.485 5.407 1.486 5.49.003 9.953-4.461 9.956-9.956.002-2.662-1.032-5.164-2.909-7.042C17.225 1.762 14.72 .727 12.008.727c-5.499 0-9.963 4.463-9.967 9.96c-.001 1.958.51 3.868 1.482 5.51L2.551 22.08l6.096-1.602c1.78.97 3.84 1.488 5.92 1.488zM18.02 14.86c-.33-.165-1.95-.963-2.25-1.073-.3-.11-.52-.165-.74.165-.22.33-.85 1.073-1.04 1.293-.19.22-.38.248-.71.083-.33-.165-1.4-.516-2.668-1.648-.986-.88-1.653-1.968-1.846-2.3-.19-.33-.02-.508.145-.672.15-.148.33-.385.495-.578.165-.192.22-.33.33-.55.11-.22.05-.413-.025-.578-.075-.165-.74-1.788-1.01-2.45-.27-.648-.54-.56-.74-.57h-.63c-.22 0-.58.083-.88.413-.3.33-1.15 1.128-1.15 2.75s1.18 3.19 1.35 3.41c.17.22 2.33 3.56 5.65 4.99 2.76 1.19 3.75 1.29 5.09 1.09.78-.115 2.33-.95 2.66-1.87.33-.92.33-1.705.23-1.87-.1-.165-.36-.275-.72-.44z"/>
                </svg>
                Inquire
              </a>
            </div>
          </div>
        ))}
      </div>

      <!-- Navigation links -->
      <div class="flex flex-wrap justify-center gap-4 pt-6">
        <a href="/courses" class="px-6 py-3 rounded-xl border-2 border-primary text-primary font-bold text-xs hover:bg-primary hover:text-white transition-all font-headline">
          Explore All Courses
        </a>
        <a href="/internships" class="px-6 py-3 rounded-xl border-2 border-primary text-primary font-bold text-xs hover:bg-primary hover:text-white transition-all font-headline">
          Explore All Internships
        </a>
        <a href="/contact" class="px-6 py-3 rounded-xl bg-slate-200 hover:bg-slate-300 text-slate-800 font-bold text-xs transition-all font-headline">
          Contact Details & Office Map
        </a>
      </div>

    </div>
  </section>

  <!-- Final CTA Section -->
  <section class="py-20 relative overflow-hidden bg-primary text-white border-t border-slate-900">
    <div class="absolute top-1/2 left-1/4 -translate-y-1/2 w-96 h-96 bg-secondary/15 rounded-full filter blur-[120px] pointer-events-none"></div>
    <div class="absolute top-1/2 right-1/4 -translate-y-1/2 w-96 h-96 bg-accent/15 rounded-full filter blur-[120px] pointer-events-none"></div>
    
    <div class="max-w-[1440px] mx-auto px-4 md:px-6 relative z-10 text-center space-y-8 max-w-3xl">
      <h2 class="text-3xl md:text-5xl font-headline font-black text-white leading-tight">
        Ready to Kickstart Your Career?
      </h2>
      <p class="text-slate-300 font-body text-base md:text-lg leading-relaxed max-w-2xl mx-auto">
        Join Margdarshak today and learn real skills with industry mentors, practical training, and recognized credentials.
      </p>
      
      <div class="flex flex-col sm:flex-row justify-center items-center gap-4 pt-4">
        <a 
          href="https://wa.me/919229025257?text=Hi%20Margdarshak%20Team,%20I'd%20like%20to%20register%20and%20join%20a%20batch." 
          target="_blank" 
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 px-8 h-14 bg-[#25D366] hover:bg-[#20ba5a] text-white rounded-2xl font-headline font-bold text-base transition-all duration-300 hover:scale-105 shadow-md w-full sm:w-auto"
        >
          <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946C.06 5.348 5.397.01 12.008.01c3.202.001 6.212 1.246 8.477 3.514 2.266 2.268 3.507 5.28 3.505 8.484-.004 6.657-5.34 11.997-11.953 11.997-2.005-.001-3.973-.502-5.724-1.455L0 24zm6.59-4.846c1.6.95 3.588 1.485 5.407 1.486 5.49.003 9.953-4.461 9.956-9.956.002-2.662-1.032-5.164-2.909-7.042C17.225 1.762 14.72 .727 12.008.727c-5.499 0-9.963 4.463-9.967 9.96c-.001 1.958.51 3.868 1.482 5.51L2.551 22.08l6.096-1.602c1.78.97 3.84 1.488 5.92 1.488zM18.02 14.86c-.33-.165-1.95-.963-2.25-1.073-.3-.11-.52-.165-.74.165-.22.33-.85 1.073-1.04 1.293-.19.22-.38.248-.71.083-.33-.165-1.4-.516-2.668-1.648-.986-.88-1.653-1.968-1.846-2.3-.19-.33-.02-.508.145-.672.15-.148.33-.385.495-.578.165-.192.22-.33.33-.55.11-.22.05-.413-.025-.578-.075-.165-.74-1.788-1.01-2.45-.27-.648-.54-.56-.74-.57h-.63c-.22 0-.58.083-.88.413-.3.33-1.15 1.128-1.15 2.75s1.18 3.19 1.35 3.41c.17.22 2.33 3.56 5.65 4.99 2.76 1.19 3.75 1.29 5.09 1.09.78-.115 2.33-.95 2.66-1.87.33-.92.33-1.705.23-1.87-.1-.165-.36-.275-.72-.44z"/>
          </svg>
          Chat on WhatsApp
        </a>
        
        <a 
          href="https://play.google.com/store/apps/details?id=co.varys.shacc" 
          target="_blank" 
          rel="noopener noreferrer"
          class="flex items-center justify-center gap-2 bg-white/5 hover:bg-white/10 border border-white/20 hover:border-white/30 text-white px-8 h-14 rounded-2xl font-headline font-bold text-base transition-all duration-300 w-full sm:w-auto hover:scale-105 shadow-glass"
        >
          <svg class="w-5 h-5 shrink-0 fill-current" viewBox="0 0 16 16">
            <path d="M14.222 9.374c1.037-.61 1.037-2.137 0-2.748L11.528 5.04 8.32 8l3.207 2.96 2.694-1.586Zm-3.595 2.116L7.583 8.68 1.03 14.73c.201 1.029 1.36 1.61 2.303 1.055l7.294-4.295ZM1 13.396V2.603L6.847 8 1 13.396ZM1.03 1.27C1.984.716 3.143 1.297 3.344 2.326L7.583 7.32 10.627 5.5l-3.044 2.82L1.03 1.27Z"/>
          </svg>
          Download Our App
        </a>
      </div>
    </div>
  </section>

</Layout>
